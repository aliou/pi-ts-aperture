{
  "name": "@aliou/pi-ts-aperture",
  "description": "Route Pi LLM providers through Tailscale Aperture",
  "version": "0.20.0",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aliou/pi-ts-aperture"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "src",
    "extensions",
    "CHANGELOG.md",
    "README.md",
    "schema.json",
    "!**/*.test.ts"
  ],
  "pi": {
    "extensions": [
      "./extensions/aperture/index.ts",
      "./extensions/mcp/index.ts"
    ],
    "video": "https://assets.aliou.me/github/aliou/pi-ts-aperture/demo.mp4",
    "image": "https://assets.aliou.me/github/aliou/pi-ts-aperture/banner.png"
  },
  "exports": {
    "./provider": {
      "types": "./dist/provider/index.d.ts",
      "import": "./dist/provider/index.js"
    }
  },
  "sideEffects": false,
  "dependencies": {
    "@aliou/pi-utils-settings": "^0.23.0",
    "@aliou/pi-utils-ui": "^0.5.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": ">=1.0.0",
    "@earendil-works/pi-tui": ">=1.0.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "check:lockfile": "pnpm install --frozen-lockfile --ignore-scripts",
    "prepare": "[ -d .git ] && husky || true",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm changeset publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:schema": "pi-settings-schema -p extensions/shared/config/types.ts -t ApertureConfig -o schema.json --version 0.17.0",
    "check:schema": "pi-settings-schema -p extensions/shared/config/types.ts -t ApertureConfig -o schema.json --version 0.17.0 --check"
  },
  "devDependencies": {
    "@aliou/biome-plugins": "^0.16.0",
    "@aliou/pi-neuralwatt": "^0.15.1",
    "@aliou/pi-synthetic": "^0.26.1",
    "@biomejs/biome": "^2.6.4",
    "@changesets/cli": "3.0.1",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "catalog:",
    "@types/node": "^25.0.10",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "ts-json-schema-generator": "^2.9.0",
    "tsdown": "^0.23.4",
    "typebox": "^1.3.27",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@11.27.0"
}
